# Produção (S3 + CloudFront) - modelo do client/.env.production
# Copie para client/.env.production (fora do git). O Vite usa este arquivo no npm run build,
# e os scripts provision-s3-cloudfront.ps1 e deploy-s3-cloudfront.ps1 também o leem.

# URL pública da API, em https (o mesmo APP_URL do server/.env.production)
VITE_API_URL=https://api.your_domain_here

AWS_REGION=us-east-1

# Preenchidos pelo provision-s3-cloudfront.ps1 na primeira execução
S3_BUCKET_NAME=
CLOUDFRONT_DISTRIBUTION_ID=

# Opcional: domínio próprio no CloudFront. O certificado do ACM precisa estar em us-east-1
FRONTEND_DOMAIN=
FRONTEND_CERTIFICATE_ARN=
# Só se o DNS estiver no Route 53; sem ele, o script imprime o CNAME para cadastrar
ROUTE53_HOSTED_ZONE_ID=
