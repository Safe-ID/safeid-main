# ==========================================================================
# PRODUÇÃO (AWS) - modelo do server/.env.production
# ==========================================================================
# Copie para server/.env.production (fora do git) e preencha. Os scripts AWS e o
# deploy.ps1 da raiz leem só este arquivo; o .env de desenvolvimento não é usado.
#
# Segredos (marcados com [SSM]) vão para o SSM Parameter Store pelo put-ssm-secrets.ps1
# e o ECS os injeta na task; nunca ficam na task definition. Gere cada um com:
#   openssl rand -base64 48        (a ENCRYPTION_KEY usa -base64 32)
# No PowerShell, sem openssl (troque 48 por 32 para a ENCRYPTION_KEY):
#   $b = New-Object byte[] 48; (New-Object Security.Cryptography.RNGCryptoServiceProvider).GetBytes($b); [Convert]::ToBase64String($b)

# --------------------------------------------------------------------------
# Conta e região
# --------------------------------------------------------------------------
AWS_REGION=us-east-1

# --------------------------------------------------------------------------
# URLs públicas (sem localhost; entram nos links dos e-mails)
# --------------------------------------------------------------------------
# API (o DNS deste domínio aponta para o ALB)
APP_URL=https://api.your_domain_here
# Frontend (CloudFront)
FRONTEND_URL=https://your_domain_here
# Opcional: padrão = FRONTEND_URL
CORS_ORIGIN=

# --------------------------------------------------------------------------
# Segredos da aplicação [SSM]
# --------------------------------------------------------------------------
JWT_SECRET=replace_with_a_random_secret
# Diferente do JWT_SECRET
REFRESH_TOKEN_SECRET=replace_with_a_random_secret
SESSION_SECRET=replace_with_a_random_secret
# Mínimo 32 caracteres; assina o link de descadastro dos alertas
MONITORING_UNSUBSCRIBE_SECRET=replace_with_a_random_secret
# Criptografia AES-256-GCM dos vazamentos no banco: exatamente 32 bytes (openssl rand -base64 32).
# Não troque depois do primeiro deploy: os dados gravados com a chave antiga deixam de ser lidos
ENCRYPTION_KEY=replace_with_a_random_secret
HIBP_API_KEY=your_hibp_api_key_here
# Opcionais [SSM]: ficam de fora se vazios
AI_API_KEY=
ADMIN_TOKEN=
# HMAC do e-mail no banco e no cache. Se definir, não troque depois
EMAIL_HASH_SECRET=

# --------------------------------------------------------------------------
# Banco (RDS) - create-database.ps1 e DATABASE_URL de produção [SSM]
# --------------------------------------------------------------------------
# A DATABASE_URL é montada com estes valores e o endpoint do RDS
DB_USER=safeid_user
# 8+ caracteres, sem / @ " nem espaço (regra do RDS)
DB_PASSWORD=replace_with_a_strong_password
DB_NAME=safeid_db
DB_SUBNET_IDS=subnet-xxxxxxxxxxxxxxxxx,subnet-yyyyyyyyyyyyyyyyy
DATABASE_SECURITY_GROUP_ID=sg-xxxxxxxxxxxxxxxxx
# Opcional: o deploy descobre o endpoint pelo identificador da instância
RDS_ENDPOINT=
DB_INSTANCE_IDENTIFIER=safeid-pg

# --------------------------------------------------------------------------
# Redis (ElastiCache) - create-redis.ps1
# --------------------------------------------------------------------------
REDIS_SUBNET_IDS=subnet-xxxxxxxxxxxxxxxxx
REDIS_SECURITY_GROUP_ID=sg-xxxxxxxxxxxxxxxxx
# Opcional: o deploy descobre o endpoint pelo ID do cluster. Nunca localhost
REDIS_HOST=
REDIS_CLUSTER_ID=safeid-redis
REDIS_ENGINE_VERSION=7.1

# --------------------------------------------------------------------------
# Rede, ALB e ECS - deploy-ecs-fargate.ps1
# --------------------------------------------------------------------------
# Subnets privadas das tasks (saída pela NAT)
BACKEND_SUBNET_IDS=subnet-xxxxxxxxxxxxxxxxx
# Subnets públicas do ALB, em 2 zonas diferentes
ALB_SUBNET_IDS=subnet-xxxxxxxxxxxxxxxxx,subnet-yyyyyyyyyyyyyyyyy
ALB_SCHEME=internet-facing
# Certificado do ACM para o domínio da API (mesma região). Vazio = só HTTP
ALB_HTTPS_CERTIFICATE_ARN=
ALB_ALLOWED_CLIENT_CIDR=0.0.0.0/0
# DISABLED com as tasks em subnet privada + NAT; ENABLED só em subnet pública sem NAT
ASSIGN_PUBLIC_IP=DISABLED
DESIRED_COUNT=1
# Opcionais (padrões): safeid-cluster, safeid-service, safeid-backend, 512 / 1024
ECS_CLUSTER_NAME=
ECR_REPOSITORY=
ECS_TASK_CPU=
ECS_TASK_MEMORY=
LOG_RETENTION_DAYS=30
SSM_PREFIX=/safeid/prod

# --------------------------------------------------------------------------
# NAT Gateway e bastion - create-nat-gateway.ps1 / create-bastion-ssm.ps1
# --------------------------------------------------------------------------
VPC_ID=vpc-xxxxxxxxxxxxxxxxx
NAT_PUBLIC_SUBNET_ID=subnet-xxxxxxxxxxxxxxxxx
NAT_PRIVATE_SUBNET_ID=subnet-yyyyyyyyyyyyyyyyy
BASTION_SUBNET_ID=subnet-xxxxxxxxxxxxxxxxx

# --------------------------------------------------------------------------
# E-mail (SES) - create-ses.ps1
# --------------------------------------------------------------------------
EMAIL_PROVIDER=ses
EMAIL_FROM="SafeID <alertas@your_domain_here>"
EMAIL_REPLY_TO=
SES_DOMAIN=your_domain_here
SES_MAIL_FROM_SUBDOMAIN=mail
AWS_SES_REGION=us-east-1
SES_CONFIGURATION_SET=safeid-default
# Use o valor que o create-ses.ps1 -Action Status mostrar (sandbox: 1)
SES_MAX_PER_SECOND=1

# --------------------------------------------------------------------------
# Alertas (SNS) - create-alerts.ps1
# --------------------------------------------------------------------------
ALERTS_EMAIL=your_project_email_here

# --------------------------------------------------------------------------
# Integrações (não sensíveis)
# --------------------------------------------------------------------------
AI_ENDPOINT=https://your-resource-name.services.ai.azure.com/openai/v1
AI_MODEL=grok-4-20-non-reasoning
# Login com Google (opcional): o segredo vai para o SSM
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=https://api.your_domain_here/api/v1/auth/google/callback

# --------------------------------------------------------------------------
# Aplicação (opcionais; vazios usam o padrão do código)
# --------------------------------------------------------------------------
LOG_LEVEL=info
SWAGGER_ENABLED=false
APP_ROLE=all
SCHEDULER_TZ=America/Sao_Paulo
MONITORING_ENABLED=true
