// This is your Prisma schema file for SafeID
// Learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================================
// AUTH & USERS
// ============================================================================

model User {
  id                    Int       @id @default(autoincrement())
  email                 String    @unique
  passwordHash          String?
  googleId              String?   @unique
  scanSnapshot          Json?
  scanSnapshotUpdatedAt  DateTime?
  termsAcceptedAt       DateTime? // Quando o usuário aceitou a Política de Privacidade (LGPD)

  // Verificação de e-mail: sem ela não há login, scan nem monitoramento
  emailVerifiedAt       DateTime?

  // Monitoramento contínuo de vazamentos (opt-in no cadastro, opt-out a qualquer momento)
  monitoringEnabled     Boolean   @default(true)
  monitoringConsentAt   DateTime?
  lastMonitoredAt       DateTime?
  breachBaselineAt      DateTime? // Quando a base de UserBreach foi definida

  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  // Relacionamentos
  scans                   ScanHistory[]
  emailVerificationTokens EmailVerificationToken[]
  breaches                UserBreach[]
  notifications           Notification[]

  @@index([email])
  @@index([monitoringEnabled, emailVerifiedAt])
  @@map("user")
}

model EmailVerificationToken {
  id         Int       @id @default(autoincrement())
  userId     Int
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash  String    @unique // SHA-256 (hex) do token; o token em claro só existe no e-mail
  expiresAt  DateTime
  usedAt     DateTime?
  createdAt  DateTime  @default(now())

  @@index([userId])
  @@map("email_verification_token")
}

// ============================================================================
// SCAN RESULTS & HISTORY
// ============================================================================

model ScanHistory {
  id              Int       @id @default(autoincrement())
  jobId           String    @unique
  userId          Int
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  emailHash       String    // SHA-256 hash do email (não armazenar email em texto)

  riskScore       Int       // 0-100
  classification  String    // LOW, MODERATE, HIGH, CRITICAL

  breachesFound   Int?      // Número de breaches encontrados
  breachData      String?   // JSON dos breaches, criptografado com AES-256-GCM quando ENCRYPTION_KEY existe

  recommendation  String?   // Texto da recomendação da IA (português)
  mitigationSteps Json?     // Lista de passos de mitigação sugeridos pela IA
  urgencyLevel    String?   // HIGH, MEDIUM, LOW

  isVerified      Boolean   @default(false)
  processedAt     DateTime?

  source          String    @default("MANUAL") // SIGNUP | MANUAL | MONITORING

  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([userId])
  @@index([emailHash])
  @@index([createdAt])
  @@map("scan_history")
}

// ============================================================================
// MONITORAMENTO DE VAZAMENTOS
// ============================================================================

// Vazamentos já conhecidos de cada usuário: base para detectar os novos
model UserBreach {
  id           Int       @id @default(autoincrement())
  userId       Int
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  breachName   String    // Breach.Name da HIBP (identificador estável)
  source       String    // BASELINE | SIGNUP | MANUAL | MONITORING
  firstSeenAt  DateTime  @default(now())
  notifiedAt   DateTime?

  @@unique([userId, breachName])
  @@index([breachName])
  @@map("user_breach")
}

// Cópia local do catálogo público da HIBP (GET /breaches)
model BreachCatalog {
  name          String    @id          // Breach.Name
  title         String
  domain        String?
  breachDate    DateTime?
  addedDate     DateTime
  modifiedDate  DateTime
  pwnCount      BigInt
  dataClasses   Json                   // string[]
  isVerified    Boolean
  isFabricated  Boolean
  isSensitive   Boolean
  isRetired     Boolean
  isSpamList    Boolean
  isMalware     Boolean
  isStealerLog  Boolean
  raw           Json                   // Payload original (mesmo formato que RiskEngine/AIEngine consomem)
  syncedAt      DateTime  @updatedAt

  @@index([addedDate])
  @@index([modifiedDate])
  @@map("breach_catalog")
}

model Notification {
  id           Int       @id @default(autoincrement())
  userId       Int
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  type         String    // NEW_BREACH
  title        String
  body         String
  payload      Json      // { breachNames, scanJobId, riskScoreBefore, riskScoreAfter, classification }
  dedupeKey    String    // sha256(type + nomes ordenados)
  readAt       DateTime?
  emailStatus  String    @default("PENDING") // PENDING | SENT | SKIPPED | FAILED
  emailSentAt  DateTime?
  createdAt    DateTime  @default(now())

  @@unique([userId, dedupeKey])
  @@index([userId, readAt])
  @@map("notification")
}
