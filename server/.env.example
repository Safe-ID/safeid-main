# Application
NODE_ENV=development
APP_NAME=SafeID Backend
APP_PORT=3000
APP_URL=http://localhost:3000
DESIRED_COUNT=1

# Database
DATABASE_URL=postgresql://<user>:<password>@localhost:5432/safeid_db?schema=public
RDS_ENDPOINT=your-rds-endpoint.amazonaws.com
DB_USER=safeid_user
DB_PASSWORD=your-db-password
DB_NAME=safeid_db

# Authentication
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRES_IN=24h
REFRESH_TOKEN_SECRET=your-refresh-token-secret-change-this-in-production
REFRESH_TOKEN_EXPIRES_IN=7d
SESSION_SECRET=your-session-secret-change-this-in-production

# Redis (optional, for caching/sessions)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# AWS Deploy (backend privado na VPC)
AWS_REGION=us-east-1
SAFEID_IMAGE_URI=123456789012.dkr.ecr.us-east-1.amazonaws.com/safeid-backend:latest
BACKEND_SUBNET_IDS=subnet-private-a
ALB_SUBNET_IDS=subnet-public-a,subnet-private-a
BASTION_SUBNET_ID=subnet-public-a
BASTION_INSTANCE_NAME=safeid-bastion
BASTION_INSTANCE_TYPE=t3.micro
BASTION_SECURITY_GROUP_NAME=safeid-bastion-sg
BASTION_ROLE_NAME=safeid-bastion-role
BASTION_PROFILE_NAME=safeid-bastion-profile
ALB_SECURITY_GROUP_NAME=safeid-alb-sg
TASK_SECURITY_GROUP_NAME=safeid-ecs-sg
DATABASE_SECURITY_GROUP_ID=sg-xxxxxxxxxxxxxxxxx
REDIS_SECURITY_GROUP_ID=sg-yyyyyyyyyyyyyyyyy
ALB_SCHEME=internet-facing
ALB_ALLOWED_CLIENT_CIDR=0.0.0.0/0
ALB_ALLOWED_CLIENT_IP=
ALB_HTTPS_CERTIFICATE_ARN=
ASSIGN_PUBLIC_IP=DISABLED
NAT_PUBLIC_SUBNET_ID=subnet-public-a
NAT_PRIVATE_SUBNET_ID=subnet-private-a
NAT_GATEWAY_NAME=safeid-nat-gateway
NAT_EIP_NAME=safeid-nat-eip
NAT_ROUTE_TABLE_NAME=safeid-private-route-table

# AI / Integrations
GOOGLE_GEMINI_API_KEY=

# HIBP (Have I Been Pwned)
HIBP_API_KEY=
HIBP_BASE_URL=https://haveibeenpwned.com/api/v3
HIBP_MIN_INTERVAL_MS=1500
HIBP_USE_MOCK=false

# Logging
LOG_LEVEL=info

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# CORS
CORS_ORIGIN=http://localhost:3001

# Swagger Documentation
SWAGGER_ENABLED=true
SWAGGER_PATH=api/docs
