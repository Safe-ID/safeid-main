# ==========================================
# CONFIGURAÇÕES DA APLICAÇÃO (BACKEND)
# ==========================================

# Application Base
NODE_ENV=development
APP_NAME=SafeID Backend
APP_PORT=3000
# URL pública da API (em produção: https://api.safeid.app.br). Usada no link de descadastro dos alertas.
APP_URL=http://localhost:3000

# Database Connection
# Formato: postgresql://<user>:<password>@<endpoint>:5432/<dbname>
# Em produção a URL vai para o SSM (put-ssm-secrets.ps1), montada a partir do RDS_ENDPOINT
# e com o pool do Prisma limitado: ?schema=public&connection_limit=10&pool_timeout=20
DATABASE_URL=postgresql://db_user:db_password@db_endpoint:5432/db_name
# Used by server/docker-compose.yml for the local PostgreSQL container.
POSTGRES_PASSWORD=replace_with_a_local_password

# Authentication & Security
JWT_SECRET=your_jwt_secret_here
REFRESH_TOKEN_SECRET=your_refresh_token_secret_here
# Opcional: chave do HMAC usado no hash do email guardado no banco e no cache.
# Vazio mantém o SHA-256 de antes.
EMAIL_HASH_SECRET=
SESSION_SECRET=your_session_secret_here
# Chave de 32 bytes (AES-256-GCM) para criptografar os dados de vazamento no banco.
# Gere com: openssl rand -base64 32
ENCRYPTION_KEY=
FRONTEND_URL=http://localhost:5173

# Google OAuth
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_CALLBACK_URL=http://localhost:3000/api/v1/auth/google/callback

# Redis Connection (Cache/Sessions)
REDIS_HOST=your_redis_endpoint_here
REDIS_PORT=6379
REDIS_PASSWORD=

# AI / Integrations
AI_API_KEY=your_ai_api_key_here
AI_ENDPOINT=https://your-resource-name.services.ai.azure.com/openai/v1
# Opcional: modelo usado nas recomendações e tempo máximo de resposta (ms)
AI_MODEL=grok-4-20-non-reasoning
AI_TIMEOUT_MS=10000

# HIBP (Have I Been Pwned)
HIBP_API_KEY=your_hibp_api_key_here
HIBP_BASE_URL=https://haveibeenpwned.com/api/v3
HIBP_USE_MOCK=false
# Opcional: fixture do catálogo usada pelo mock (padrão: tests/fixtures/hibp-breaches.json)
HIBP_CATALOG_FIXTURE=
# Limite de requisições: vem do Rpm do plano (GET /subscription/status) x HIBP_RPM_SAFETY_FACTOR.
# Trocar de plano não exige mudar nada aqui.
# HIBP_RPM_LIMIT: opcional, só para forçar um valor MENOR que o do plano
HIBP_RPM_LIMIT=
HIBP_RPM_SAFETY_FACTOR=0.9
# Usado só se /subscription/status falhar e não houver plano em cache no Redis
HIBP_RPM_FALLBACK=10
HIBP_EXPECTED_LATENCY_S=1.5

# Papel do processo: all (API + workers) | api (só API) | worker (só workers, sem HTTP)
APP_ROLE=all

# ==========================================
# MONITORAMENTO DE VAZAMENTOS
# ==========================================
# Horários dos agendamentos em SCHEDULER_TZ (BRT). Usados a partir da fase F4.
SCHEDULER_TZ=America/Sao_Paulo
MONITORING_ENABLED=true
HIBP_PLAN_CHECK_CRON=0 2 * * *
HIBP_CATALOG_SYNC_CRON=0 */6 * * *
HIBP_CATALOG_PROBE_CRON=5 * * * *
MONITORING_RECONCILE_CRON=20 * * * *
MONITORING_WEEKLY_SWEEP_CRON=0 3 * * 1
MONITORING_MAX_SWEEP_HOURS=6
UNVERIFIED_CLEANUP_CRON=30 4 * * *
UNVERIFIED_ACCOUNT_TTL_DAYS=7
# Segredo do link de opt-out dos alertas (mínimo 32 bytes). Em produção vai para o SSM.
MONITORING_UNSUBSCRIBE_SECRET=change_me_32_bytes_min
# Protege GET /api/health/jobs (header X-Admin-Token). Em produção vai para o SSM.
ADMIN_TOKEN=change_me

# ==========================================
# E-MAIL (verificação de conta e alertas)
# ==========================================
# console: só registra assunto e links no log (dev/test) | ses: Amazon SES
EMAIL_PROVIDER=console
EMAIL_FROM="SafeID <alertas@safeid.app.br>"
EMAIL_REPLY_TO=your_project_email@gmail.com
AWS_SES_REGION=us-east-1
SES_CONFIGURATION_SET=safeid-default
SES_MAX_PER_SECOND=1
EMAIL_VERIFICATION_TTL_HOURS=24

# Logging & Rate Limiting
LOG_LEVEL=info
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# API Documentation & CORS
CORS_ORIGIN=https://www.yourdomain.com
SWAGGER_ENABLED=true
SWAGGER_PATH=api/docs

# CloudFront Validation (Secret received in headers)
X-Origin-Secret=your_cloudfront_secret_header_here


# ==========================================
# CONFIGURAÇÕES DE INFRAESTRUTURA (SCRIPTS AWS)
# ==========================================

# AWS Base & ECR
AWS_REGION=us-east-1
SAFEID_IMAGE_URI=your_account_id.dkr.ecr.us-east-1.amazonaws.com/your-repo-name:latest
DESIRED_COUNT=1

# Database Provisioning (create-database.ps1 e DATABASE_URL de produção)
RDS_ENDPOINT=your_rds_endpoint_here
DB_USER=your_db_user_here
DB_PASSWORD=your_db_password_here
DB_NAME=your_db_name_here
DB_SUBNET_IDS=subnet-xxxxxxxxxxxxxxxxx,subnet-yyyyyyyyyyyyyyyyy

# Redis Provisioning (create-redis.ps1)
REDIS_SUBNET_IDS=subnet-xxxxxxxxxxxxxxxxx
REDIS_ENGINE_VERSION=7.1

# Networking (Subnets)
BACKEND_SUBNET_IDS=subnet-xxxxxxxxxxxxxxxxx
ALB_SUBNET_IDS=subnet-xxxxxxxxxxxxxxxxx,subnet-yyyyyyyyyyyyyyyyy

# Security Groups
ALB_SECURITY_GROUP_NAME=safeid-alb-sg
TASK_SECURITY_GROUP_NAME=safeid-ecs-sg
DATABASE_SECURITY_GROUP_ID=sg-xxxxxxxxxxxxxxxxx
REDIS_SECURITY_GROUP_ID=sg-xxxxxxxxxxxxxxxxx

# Application Load Balancer (ALB)
ALB_SCHEME=internet-facing
ALB_HTTPS_CERTIFICATE_ARN=arn:aws:acm:us-east-1:your_account_id:certificate/your_certificate_uuid
ALB_ALLOWED_CLIENT_CIDR=0.0.0.0/0
ALB_ALLOWED_CLIENT_IP=

# ECS Fargate Settings
ASSIGN_PUBLIC_IP=DISABLED

# NAT Gateway Settings
VPC_ID=vpc-xxxxxxxxxxxxxxxxx
NAT_PUBLIC_SUBNET_ID=subnet-xxxxxxxxxxxxxxxxx
NAT_PRIVATE_SUBNET_ID=subnet-yyyyyyyyyyyyyyyyy
NAT_GATEWAY_NAME=safeid-nat-gateway
NAT_EIP_NAME=safeid-nat-eip
NAT_ROUTE_TABLE_NAME=safeid-private-route-table

# Bastion Host Configs
BASTION_SUBNET_ID=subnet-xxxxxxxxxxxxxxxxx
BASTION_INSTANCE_NAME=safeid-bastion
BASTION_INSTANCE_TYPE=t3.micro
BASTION_SECURITY_GROUP_NAME=safeid-bastion-sg
BASTION_ROLE_NAME=safeid-bastion-role
BASTION_PROFILE_NAME=safeid-bastion-profile

# CloudFront Provisioning Configs
CLOUDFRONT_ORIGIN_SECRET=your_cloudfront_origin_secret_here
API_DOMAIN=api.yourdomain.com
CLOUDFRONT_DISTRIBUTION_ID=your_distribution_id_here

# Segredos no SSM Parameter Store (put-ssm-secrets.ps1 + deploy-ecs-fargate.ps1)
SSM_PREFIX=/safeid/prod
ECS_TASK_ROLE_NAME=safeid-task-role
LOG_RETENTION_DAYS=30

# Alertas (create-alerts.ps1): e-mail que recebe os alarmes do SNS
ALERTS_EMAIL=your_project_email@gmail.com
