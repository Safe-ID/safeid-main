{
    "compilerOptions":  {
                            "module":  "commonjs",
                            "target":  "ES2020",
                            "lib":  [
                                        "ES2020"
                                    ],
                            "outDir":  "./dist",
                            "rootDir":  "./src",
                            "baseUrl":  "./src",
                            "paths":  {
                                          "@/*":  [
                                                      "*"
                                                  ],
                                          "@types/*":  [
                                                           "@types/*"
                                                       ],
                                          "@api/*":  [
                                                         "api/*"
                                                     ],
                                          "@core/*":  [
                                                          "core/*"
                                                      ],
                                          "@infra/*":  [
                                                           "infra/*"
                                                       ],
                                          "@shared/*":  [
                                                            "shared/*"
                                                        ]
                                      },
                            "strict":  true,
                            "esModuleInterop":  true,
                            "skipLibCheck":  true,
                            "forceConsistentCasingInFileNames":  true,
                            "resolveJsonModule":  true,
                            "allowSyntheticDefaultImports":  true,
                            "declaration":  true,
                            "ignoreDeprecations":  "5.0",
                            "declarationMap":  true,
                            "sourceMap":  true,
                            "experimentalDecorators":  true,
                            "emitDecoratorMetadata":  true,
                            "incremental":  false
                        },
    "include":  [
                    "src/**/*"
                ],
    "exclude":  [
                    "node_modules",
                    "dist",
                    "tests"
                ]
}
